---
/** Alterna entre tema claro e escuro (preferência salva no navegador). */

interface Props {
  claro?: boolean; // versão para fundo escuro (tela de login)
}
const { claro = false } = Astro.props;
---

<button
  type="button"
  class:list={['btn btn-icone btn-fantasma botao-tema', { claro }]}
  data-botao-tema
  aria-label="Ativar tema escuro"
>
  <span class="icone-lua">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="lua"
      focusable="false"
    >
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </span>
  <span class="icone-sol">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="sol"
      focusable="false"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
  </span>
</button>
<style>
  .botao-tema .icone-sol {
    display: none;
  }
  :global([data-tema='escuro']) .botao-tema .icone-sol {
    display: block;
  }
  :global([data-tema='escuro']) .botao-tema .icone-lua {
    display: none;
  }
  .botao-tema.claro {
    color: var(--menu-texto);
    border-color: rgb(255 255 255 / 0.35);
  }
  .botao-tema.claro:hover {
    background: rgb(255 255 255 / 0.1);
  }
</style>
<script>
  import { alternarTema, lerPreferencias } from '../scripts/preferencias';

  function atualizarRotulos() {
    const tema = lerPreferencias().tema;
    document.querySelectorAll<HTMLButtonElement>('[data-botao-tema]').forEach((botao) => {
      botao.setAttribute(
        'aria-label',
        tema === 'claro' ? 'Ativar tema escuro' : 'Ativar tema claro',
      );
      botao.title = tema === 'claro' ? 'Tema escuro' : 'Tema claro';
    });
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-botao-tema]')) {
      return;
    }

    alternarTema();
    atualizarRotulos();
  });
  document.addEventListener('astro:page-load', atualizarRotulos);
  document.addEventListener('preferencias-alteradas', atualizarRotulos);
  atualizarRotulos();
</script>
