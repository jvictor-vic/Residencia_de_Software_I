---
const { ativo = false } = Astro.props;
---

<button class:list={["button", { ativo }]} aria-pressed={ativo}>NÃO</button>

<style>
  .button {
    width: 110px;
    height: 50px;
    border: none;
    border-radius: 8px;
    background-color: #df4c4c;
    color: white;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    text-transform: uppercase;
    transition: box-shadow 0.2s;
  }

  .button:hover,
  .button:focus-visible,
  .button.ativo {
    box-shadow: inset 0 0 0 3px rgb(0 0 0 / 15%);
  }
</style>
