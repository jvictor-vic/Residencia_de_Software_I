---
import getIDsemantico, { type options } from '@utils/getIDsemantico';

interface Props {
  canal: options;
  titulo: string;
  descricao: string;
  aluno?: string;
  data?: Date;
}

const { canal, titulo, descricao, aluno, data = new Date() } = Astro.props;
const estiloSemantico = getIDsemantico(canal);
const IconeCanal = estiloSemantico.icon;
const dataISO = [
  data.getFullYear(),
  String(data.getMonth() + 1).padStart(2, '0'),
  String(data.getDate()).padStart(2, '0'),
].join('-');
const dataFormatada = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
}).format(data);
---

<article class="card-aviso">
  <aside class:list={['barra-lateral', estiloSemantico.pattern]}>
    <IconeCanal class="icone-canal" />
  </aside>

  <div class="card-content">
    <header class="cardHeader">
      <h3>{titulo}</h3>
      <div class="cabecalho-legenda">
        <p class="canal">{estiloSemantico.canal}</p>
        <time class="legenda" datetime={dataISO}>
          {dataFormatada}
        </time>
      </div>
      {aluno && <p class="aluno">Aluno: {aluno}</p>}
    </header>
    <main class="cardText">
      <p>{descricao}</p>
    </main>
  </div>
</article>

<style
  define:vars={{
    'semantic-bg': estiloSemantico.bg,
    // 'semantic-fg': estiloSemantico.fg,
  }}
>
  .card-aviso {
    height: 228px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    overflow: hidden;
    border: 2px solid var(--semantic-bg);
    border-radius: 12px;
    background: var(--bg);
    box-shadow: 0 4px 8px rgb(0 0 0 / 0.15);
    transition: all 0.6s ease;
  }

  .card-aviso:hover {
    box-shadow: 4px 8px 8px rgb(0 0 0 / 0.5);
  }

  :global(.icone-canal) {
    flex: 0 0 auto;
    width: auto;
    height: auto;
    max-width: none;
  }

  .barra-lateral {
    flex: 0 0 auto;
    height: 100%;
    width: fit-content;
    padding: 26px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;

    color: var(--fg);
  }

  .card-content {
    height: 100%;
    width: 100%;
    padding: 16px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .cardHeader {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: flex-start;
    justify-content: center;
    color: var(--fg);

    h3 {
      text-box: trim-end cap alphabetic;
    }

    .cabecalho-legenda {
      width: 100%;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .cabecalho-legenda .canal {
      font-weight: 700;
      color: var(--fg--20);
    }

    .legenda {
      flex: 0 0 auto;
      text-align: right;
      color: var(--fg--20);
    }

    .aluno {
      color: var(--fg--20);
      font-weight: 700;
    }
  }

  .cardText {
    height: 100%;
  }
</style>
