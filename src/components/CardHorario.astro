---
import infoIcon from '@assets/icons/info.svg';

interface Props {
  materia?: string;
  professor?: string;
}

const { materia = 'Matéria', professor = 'Prof. Nome Sobrenome' } = Astro.props;
---

<div class="card-horario">
  <div class="card-content">
    <div class="card-header">
      <img src={infoIcon.src} alt="Info" class="icon" />
      <h4 class="materia">{materia}</h4>
    </div>
    <h6 class="professor">{professor}</h6>
  </div>
</div>

<style>
  .card-horario {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;

    background-color: var(--id-05-bg);
    transition: border-radius 0.3s ease;
  }

  .card-horario:hover {
    border-radius: 6px 24px 6px 24px;
  }

  .card-content {
    background-color: var(--bg);
    border-radius: 0 24px 0 24px;
    width: 100%;
    height: 100%;
    padding: 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .card-header {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }
  .icon {
    width: 24px;
  }
</style>
