---
import '../../variables.css';
import infoIcon from '../../assets/icons/info.svg';

interface Props {
  materia?: string;
  professor?: string;
}

const {
  materia = 'Matéria',
  professor = 'Prof. Nome Sobrenome',
} = Astro.props;
---

<div class="card-horario">
  <div class="card-content">
    <div class="card-header">
      <img src={infoIcon.src} alt="Info" class="icon" />
      <span class="materia">{materia}</span>
    </div>
    <span class="professor">{professor}</span>
  </div>
</div>

<style>
  .card-horario {
    position: relative;
    width: 160px;
    height: 110px;
    margin: 4px;
    padding: 4px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    z-index: 1;
  }

  .card-horario::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--id-05-bg);
    z-index: -1;
    transition: border-radius 0.3s ease;
  }

  .card-horario:hover::before { border-radius: 12px; }

  .card-content {
    background-color: var(--light);
    border-radius: 0 24px 0 24px;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 4px;
    box-sizing: border-box;
  }

  .card-header { display: flex; align-items: center; gap: 4px; }
  .icon { width: 14px; height: 14px; }
  .materia { font-weight: 600; font-size: 14px; color: var(--fg-10); }
  .professor { font-size: 11px; color: var(--fg-40); }
</style>
