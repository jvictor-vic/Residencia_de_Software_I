---
import IconBoletim from '@assets/icons/boletim.svg';
import IconAgenda from '@assets/icons/calendario.svg';
import IconHorario from '@assets/icons/horario.svg';
import IconMaterias from '@assets/icons/materias.svg';
import IconSecretaria from '@assets/icons/secretaria.svg';

import getDiaSemana from '@utils/getDiaSemana.ts';
const diaSemana = getDiaSemana(new Date(), 'curto');
const caminhoAtual = Astro.url.pathname.replace(/\/+$/, '') || '/';
const paginaAtiva = (caminho: string) => {
  const caminhoNormalizado = caminho.replace(/\/+$/, '') || '/';
  return caminhoAtual === caminhoNormalizado || caminhoAtual.startsWith(`${caminhoNormalizado}/`);
};
---

<nav aria-label="Menu Navegação">
  <ul class="menu-lista">
    <li>
      <a
        href="/academico/boletim/"
        aria-current={paginaAtiva('/academico/boletim/') ? 'page' : undefined}
      >
        <IconBoletim />
        <span>Boletim</span>
      </a>
    </li>
    <li>
      <a
        href="/academico/agenda/"
        aria-current={paginaAtiva('/academico/agenda/') ? 'page' : undefined}
      >
        <IconAgenda />
        <span>Agenda</span>
      </a>
    </li>
    <li>
      <a
        href="/academico/horario/"
        aria-current={paginaAtiva('/academico/horario/') ? 'page' : undefined}
      >
        <div id="iconeHorario">
          <span id="diaSemana">{diaSemana}</span>
          <IconHorario />
        </div>
        <span>Horário</span>
      </a>
    </li>
    <li>
      <a
        href="/academico/materias/"
        aria-current={paginaAtiva('/academico/materias/') ? 'page' : undefined}
      >
        <IconMaterias />
        <span>Materias</span>
      </a>
    </li>
    <li>
      <a
        href="/academico/secretaria/"
        aria-current={paginaAtiva('/academico/secretaria/') ? 'page' : undefined}
      >
        <IconSecretaria />
        <span>Secretaria</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  nav {
    width: 100vw;
    height: 80px;
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    padding: 6px;
    border-radius: 24px 24px 0 0;

    background-color: var(--primary);

    overflow: clip;
    z-index: 20;
  }

  .menu-lista {
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    list-style: none;
    padding: 0;
  }

  .menu-lista > li {
    min-width: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-lista span {
    font-size: 14px;
  }

  .menu-lista a {
    width: 100%;
    min-width: 76px;
    position: relative;
    padding: 4px 8px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    text-decoration: none;

    border-radius: 12px;
    color: var(--bg);
  }

  .menu-lista a[aria-current='page'] {
    background-color: var(--bg);
    color: var(--fg);
    font-weight: 700;
    box-shadow: 0 -2px 6px 2px rgb(18 12 7 / 0.35);

    #diaSemana {
      color: var(--bg);
    }
  }

  .menu-lista a[aria-current='page']::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 25%;
    right: 25%;
    height: 6px;
    border-radius: 0 0 4px 4px;
    background-color: var(--secondary);
  }

  .menu-lista a:focus-visible {
    outline-color: var(--secondary);
  }

  #iconeHorario {
    position: relative;
    color: inherit;
  }
  #diaSemana {
    font-size: 0.9rem;
    position: absolute;
    color: var(--primary);
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
</style>
