---
import BaseHead from '@components/BaseHead.astro';
import BotaoTema from '@components/BotaoTema.astro';
import Notificacoes from '@components/Notificacoes.astro';
import NavBarMobile from '@components/academico-modulo/NavBarMobile.astro';
import NavBarDesktop from '@components/academico-modulo/NavBarDesktop.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Área acadêmica | EducaHub', description = 'Área acadêmica do EducaHub.' } =
  Astro.props;
const user = Astro.locals.authenticatedUser;

if (!user) {
  return Astro.redirect('/entrar');
}

if (!user.papeis.every((papel) => papel === 'aluno' || papel === 'responsavel')) {
  return Astro.redirect('/403');
}

const nomePerfil = user.dadosPessoais.nomeSocial?.trim() || user.dadosPessoais.nomeCompleto;
const papeis = user.papeis
  .map((papel) => (papel === 'responsavel' ? 'Responsável' : 'Aluno'))
  .join(' e ');
const avisos = user.perfis.aluno?.avisos ?? [];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} transition={true} />
  </head>
  <body>
    <header class="topo" aria-label="Cabeçalho do perfil">
      <div class="topo-acoes">
        <BotaoTema />
        <Notificacoes perfil={user.cpf} avisos={avisos} />
        <div class="topo-usuario">
          <span class="avatar" aria-hidden="true">
            {user.iniciais}
          </span>
          <span class="topo-usuario-texto">
            <span class="topo-usuario-nome">{nomePerfil}</span>
            <span class="topo-usuario-papel">{papeis}</span>
          </span>
        </div>
      </div>
    </header>

    <div class="mobile">
      <NavBarMobile />
    </div>

    <div class="desktop">
      <NavBarDesktop />
    </div>
    <main transition:animate="slide">
      <slot />
      <footer class="suave">
        <span class="footer-text">
          EducaHub · Protótipo acadêmico — Residência de Software I · UNIT · Dados fictícios
        </span>
      </footer>
    </main>
  </body>
</html>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    min-height: 72px;
    padding: 8px var(--side-padding);
    border-bottom: 1px solid var(--fg--80);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
  }

  .topo-acoes {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .topo :global(.botao-tema) {
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .topo :global(.botao-tema:hover) {
    background: var(--fg--90);
  }

  .topo :global(.botao-tema:focus-visible) {
    outline: 2px solid var(--primary-darker);
    outline-offset: 2px;
  }

  .topo-usuario {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 4px 12px 4px 4px;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
  }

  .topo-usuario:hover {
    background: var(--fg--90);
  }

  .topo-usuario-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .topo-usuario-nome {
    font-weight: 700;
  }

  .topo-usuario-papel {
    color: var(--fg--50);
    font-size: 14px;
  }

  .avatar {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 2px solid var(--primary-darker);
    border-radius: 50%;
    background: var(--primary);
    color: var(--bg);
    font-weight: 800;
  }

  /* Exibição Responsiva */
  /* Padrão - Mobbile */
  .mobile {
    display: block;
  }
  .desktop {
    display: none;
  }

  /* Padrão - Desktop */
  @media (min-width: 768px) {
    .mobile {
      display: none;
    }
    .desktop {
      display: block;
    }

    main {
      margin-left: 276px;
    }

    .topo {
      padding-left: calc(276px + var(--side-padding));
    }
  }

  @media (max-width: 600px) {
    .topo-usuario-texto {
      display: none;
    }
  }

  /* Layout */

  main {
    min-height: 100vh;
    padding: 20px var(--side-padding);
  }

  footer {
    position: relative;
    bottom: 0;
    width: 100%;

    margin-top: 20px;
    padding: 8px 0;

    border-top: 2px solid var(--fg--80);
    color: var(--fg--70);

    .footer-text {
      font-family: var(--font-cabin);
      font-weight: 500;
      overflow-wrap: break-word;
      text-wrap-style: balance;
    }
  }
</style>
