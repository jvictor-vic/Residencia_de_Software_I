---
/**
 * Layout das telas internas (depois do login):
 * menu lateral do perfil + barra do topo + conteúdo.
 */
import BaseLayout from './BaseLayout.astro';
import Icone from '../components/Icone.astro';
import Logo from '../components/Logo.astro';
import BotaoTema from '../components/BotaoTema.astro';
import Notificacoes from '../components/Notificacoes.astro';
import { perfis, link, url, type PerfilId } from '../data/perfis';

interface Props {
  perfil: PerfilId;
  titulo: string;
  subtitulo?: string;
  ajuda: string;
  /** caminho do item de menu ativo ("" = início) */
  ativo: string;
}

const { perfil: perfilId, titulo, subtitulo, ajuda, ativo } = Astro.props;
const perfil = perfis[perfilId];
---

<BaseLayout titulo={`${titulo} (${perfil.nome})`} ajuda={ajuda}>
  <a class="pular-conteudo" href="#conteudo">
    Pular para o conteúdo
  </a>

  <div class="app" data-perfil={perfil.id}>
    <aside class="menu" id="menu-lateral" aria-label="Menu principal">
      <a class="menu-marca" href={url()} aria-label="EducaHub — voltar para a página inicial">
        <Logo tamanho={38} sobreAzul />
      </a>

      <div class="menu-perfil">
        <span
          class="menu-perfil-icone pad-pontos"
          style={`background-color:${perfil.cor}`}
          aria-hidden="true"
        >
          <Icone nome={perfil.icone} />
        </span>
        <div>
          <p class="menu-perfil-rotulo">Perfil</p>
          <p class="menu-perfil-nome">{perfil.nome}</p>
        </div>
      </div>

      <nav aria-label={`Menu do perfil ${perfil.nome}`}>
        <ul class="menu-lista">
          {perfil.menu.map((item) => (
            <li>
              <a
                href={link(perfil.id, item.caminho)}
                aria-current={item.caminho === ativo ? 'page' : undefined}
              >
                <Icone nome={item.icone} />
                <span>{item.rotulo}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a class="menu-sair" href={url('entrar/')} data-sair>
        <Icone nome="sair" />
        <span>Sair / trocar perfil</span>
      </a>
    </aside>
    <div class="menu-fundo" data-fechar-menu hidden></div>

    <div class="app-principal">
      <header class="topo">
        <button
          type="button"
          class="btn btn-icone btn-fantasma topo-menu"
          aria-controls="menu-lateral"
          aria-expanded="false"
          aria-label="Abrir menu"
          data-abrir-menu
        >
          <Icone nome="menu" />
        </button>

        <p class="topo-escola suave">
          <Icone nome="escola" tamanho={20} />
          <span>E. E. Jardim das Mangabeiras</span>
        </p>

        <div class="topo-acoes">
          <BotaoTema />
          <Notificacoes perfil={perfil.id} />
          <a
            class="topo-usuario"
            href={link(perfil.id, 'configuracoes')}
            aria-label={`${perfil.usuario.nome}: abrir configurações`}
          >
            <span class="avatar" style={`background-color:${perfil.cor}`} aria-hidden="true">
              {perfil.usuario.iniciais}
            </span>
            <span class="topo-usuario-texto">
              <span class="negrito">{perfil.usuario.nome}</span>
              <span class="suave">{perfil.usuario.detalhe}</span>
            </span>
          </a>
        </div>
      </header>

      <main id="conteudo" tabindex="-1">
        <div class="cabecalho-pagina surgir">
          <h1>{titulo}</h1>
          {subtitulo && <p class="suave">{subtitulo}</p>}
        </div>
        <slot />
      </main>

      <footer class="rodape suave">
        EducaHub · Protótipo acadêmico — Residência de Software I · UNIT · Dados fictícios
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  .app {
    display: grid;
    grid-template-columns: var(--largura-menu) minmax(0, 1fr);
    min-height: 100vh;
  }

  /* ---------- Menu lateral ---------- */
  .menu {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
    padding: var(--e-5) var(--e-4);
    background: var(--menu-fundo);
    color: var(--menu-texto);
    overflow-y: auto;
  }
  .menu-marca {
    color: inherit;
    text-decoration: none;
    padding: var(--e-1) var(--e-2);
  }
  .menu-perfil {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    padding: var(--e-3);
    border-radius: var(--raio);
    background: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.12);
  }
  .menu-perfil p {
    margin: 0;
    line-height: 1.3;
  }
  .menu-perfil-icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--fg);
    border: 2px solid var(--fg);
  }
  .menu-perfil-rotulo {
    color: var(--menu-texto-suave);
  }
  .menu-perfil-nome {
    font-weight: 700;
    font-size: var(--texto-md);
  }
  .menu-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--e-1);
  }
  .menu-lista a,
  .menu-sair {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--e-3);
    min-height: var(--alvo-min);
    padding: var(--e-2) var(--e-3);
    border-radius: var(--raio);
    color: var(--menu-texto);
    text-decoration: none;
  }
  .menu-lista a:hover,
  .menu-sair:hover {
    background: var(--menu-hover);
  }
  .menu-lista a[aria-current='page'] {
    background: var(--menu-ativo);
    color: var(--menu-ativo-texto);
    font-weight: 700;
    box-shadow: 3px 4px 0 rgb(18 12 7 / 0.35);
  }
  /* Indicador que não depende de cor: barra amarela + negrito */
  .menu-lista a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 10px;
    bottom: 10px;
    width: 5px;
    border-radius: 4px;
    background: var(--destaque);
  }
  .menu-lista a:focus-visible,
  .menu-sair:focus-visible,
  .menu-marca:focus-visible {
    outline-color: var(--light);
  }
  .menu-sair {
    margin-top: auto;
    border: 1px solid rgb(255 255 255 / 0.2);
  }

  /* ---------- Topo ---------- */
  .app-principal {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .topo {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--e-3);
    min-height: 72px;
    padding: var(--e-2) var(--e-6);
    background: color-mix(in srgb, var(--fundo) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--borda);
  }
  .topo-menu {
    display: none;
  }
  .topo-escola {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    margin: 0;
    font-weight: 700;
  }
  .topo-acoes {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    margin-left: auto;
  }
  .topo-usuario {
    display: flex;
    align-items: center;
    gap: var(--e-3);
    min-height: var(--alvo-min);
    padding: var(--e-1) var(--e-3) var(--e-1) var(--e-1);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
  }
  .topo-usuario:hover {
    background: var(--superficie-2);
  }
  .topo-usuario-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 2px solid var(--fg);
    color: var(--fg);
    font-family: var(--fonte-titulo);
    font-weight: 800;
  }

  /* ---------- Conteúdo ---------- */
  main {
    flex: 1;
    width: 100%;
    max-width: 1280px;
    padding: var(--e-6) var(--e-6) var(--e-7);
  }
  main:focus {
    outline: none;
  }
  .cabecalho-pagina {
    margin-bottom: var(--e-6);
  }
  .cabecalho-pagina h1 {
    font-size: var(--texto-2xl);
    margin-bottom: var(--e-1);
  }
  .cabecalho-pagina p {
    margin: 0;
    font-size: var(--texto-md);
  }
  .rodape {
    padding: var(--e-4) var(--e-6) 96px;
    border-top: 1px solid var(--borda);
  }

  /* ---------- Celular / tablet ---------- */
  @media (max-width: 1100px) {
    .topo-usuario-texto,
    .topo-escola span {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .app {
      grid-template-columns: 1fr;
    }
    .menu {
      position: fixed;
      left: 0;
      top: 0;
      z-index: 45;
      width: min(var(--largura-menu), 85vw);
      transform: translateX(-100%);
      transition: transform 0.2s ease-out;
      visibility: hidden;
    }
    .menu.aberto {
      transform: none;
      visibility: visible;
    }
    .menu-fundo:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: 44;
      background: rgb(10 15 25 / 0.55);
    }
    .topo-menu {
      display: inline-flex;
    }
    .topo,
    main,
    .rodape {
      padding-left: var(--e-4);
      padding-right: var(--e-4);
    }
    main {
      padding-top: var(--e-5);
    }
  }
</style>

<script>
  const menu = document.getElementById('menu-lateral');
  const fundo = document.querySelector<HTMLElement>('[data-fechar-menu]');
  const botao = document.querySelector<HTMLButtonElement>('[data-abrir-menu]');

  function abrirMenu(abrir: boolean) {
    menu?.classList.toggle('aberto', abrir);
    if (fundo) fundo.hidden = !abrir;
    botao?.setAttribute('aria-expanded', String(abrir));
    botao?.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
    if (abrir) menu?.querySelector<HTMLAnchorElement>("a[aria-current='page'], a")?.focus();
  }

  botao?.addEventListener('click', () => abrirMenu(!menu?.classList.contains('aberto')));
  fundo?.addEventListener('click', () => abrirMenu(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('aberto')) {
      abrirMenu(false);
      botao?.focus();
    }
  });
</script>
