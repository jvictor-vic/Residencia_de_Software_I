---
import Academico from '@layouts/Academico.astro';
import Icone from '@components/Icone.astro';
import { pedidosAna, tiposPedido } from '@data/dados';
---

<Academico title="Secretaria virtual | EducaHub">
  <section class="pagina" aria-labelledby="titulo-pagina">
    <header class="introducao">
      <h1 id="titulo-pagina">Secretaria virtual</h1>
      <p>Peça documentos sem precisar ir até a escola.</p>
    </header>

    <div class="grade">
      <section class="card" aria-labelledby="titulo-novo">
        <h2 id="titulo-novo">
          <Icone nome="mais" /> Novo pedido
        </h2>
        <form id="form-pedido">
          <fieldset class="tipos">
            <legend>Tipo de pedido</legend>
            {tiposPedido.map((tipo, indice) => (
              <label class="opcao">
                <input
                  type="radio"
                  name="tipo"
                  value={tipo}
                  checked={indice === 0}
                  required={indice === 0}
                />
                <span>{tipo}</span>
              </label>
            ))}
          </fieldset>

          <div class="campo">
            <label for="observacao">
              Observação <span class="suave">(opcional)</span>
            </label>
            <textarea
              id="observacao"
              name="observacao"
              rows="4"
              maxlength="500"
              placeholder="Ex.: preciso da declaração para o passe estudantil."
            ></textarea>
          </div>

          <button type="submit" class="botao-primario">
            <Icone nome="enviar" /> Enviar pedido
          </button>
          <p id="feedback-pedido" class="feedback" role="status" aria-live="polite"></p>
        </form>
      </section>

      <section class="card" aria-labelledby="titulo-pedidos">
        <h2 id="titulo-pedidos">
          <Icone nome="arquivo" /> Meus pedidos
        </h2>
        <ul class="lista-pedidos" id="lista-pedidos">
          {pedidosAna.map((pedido) => (
            <li>
              <span class="icone-pedido" aria-hidden="true">
                <Icone nome="arquivo" />
              </span>
              <div class="pedido-corpo">
                <p class="pedido-tipo">{pedido.tipo}</p>
                <p class="pedido-info">
                  Protocolo {pedido.protocolo} · {pedido.data}
                </p>
              </div>
              <span class:list={['status-pedido', `status-${pedido.status}`]}>
                {pedido.status === 'concluido' ? 'Concluído' : 'Em análise'}
              </span>
            </li>
          ))}
        </ul>

        <template id="modelo-pedido">
          <li>
            <span class="icone-pedido" aria-hidden="true">
              <Icone nome="arquivo" />
            </span>
            <div class="pedido-corpo">
              <p class="pedido-tipo" data-campo="tipo"></p>
              <p class="pedido-info" data-campo="info"></p>
            </div>
            <span class="status-pedido status-analise">Em análise</span>
          </li>
        </template>
      </section>
    </div>
  </section>
</Academico>

<script>
  import { tiposPedido } from '@data/dados';

  interface PedidoNovo {
    protocolo: string;
    tipo: string;
    data: string;
  }

  function isPedidoNovo(valor: unknown): valor is PedidoNovo {
    if (typeof valor !== 'object' || valor === null) return false;
    const pedido = valor as Record<string, unknown>;
    return (
      typeof pedido.protocolo === 'string' &&
      typeof pedido.tipo === 'string' &&
      typeof pedido.data === 'string' &&
      tiposPedido.includes(pedido.tipo)
    );
  }

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('#form-pedido');
    const lista = document.querySelector<HTMLUListElement>('#lista-pedidos');
    const modelo = document.querySelector<HTMLTemplateElement>('#modelo-pedido');
    const feedback = document.querySelector<HTMLParagraphElement>('#feedback-pedido');

    if (!form || !lista || !modelo || !feedback) {
      throw new Error('Não foi possível inicializar os pedidos da secretaria.');
    }

    const listaPedidos = lista;
    const modeloPedido = modelo;
    const feedbackPedido = feedback;
    const chaveArmazenamento = 'educahub:pedidos';
    let pedidosSalvos: PedidoNovo[] = [];

    function mostrarFeedback(mensagem: string, erro = false): void {
      feedbackPedido.textContent = mensagem;
      feedbackPedido.classList.toggle('feedback-erro', erro);
      feedbackPedido.classList.toggle('feedback-sucesso', !erro && mensagem.length > 0);
    }

    function adicionarNaLista(pedido: PedidoNovo): void {
      const elemento = modeloPedido.content.firstElementChild?.cloneNode(true);
      if (!(elemento instanceof HTMLLIElement)) {
        throw new Error('O modelo de pedido da secretaria está inválido.');
      }

      const campoTipo = elemento.querySelector<HTMLElement>('[data-campo="tipo"]');
      const campoInfo = elemento.querySelector<HTMLElement>('[data-campo="info"]');
      if (!campoTipo || !campoInfo) {
        throw new Error('O modelo de pedido não contém os campos esperados.');
      }

      campoTipo.textContent = pedido.tipo;
      campoInfo.textContent = `Protocolo ${pedido.protocolo} · ${pedido.data}`;
      listaPedidos.prepend(elemento);
    }

    try {
      const valorSalvo = localStorage.getItem(chaveArmazenamento);
      if (valorSalvo !== null) {
        const dados: unknown = JSON.parse(valorSalvo);
        if (!Array.isArray(dados) || !dados.every(isPedidoNovo)) {
          throw new TypeError('Os pedidos armazenados têm um formato inválido.');
        }
        pedidosSalvos = dados;
        pedidosSalvos.forEach(adicionarNaLista);
      }
    } catch (erro) {
      console.error('Não foi possível carregar os pedidos salvos.', erro);
      mostrarFeedback(
        'Não foi possível carregar os pedidos salvos. Os pedidos de demonstração continuam disponíveis.',
        true,
      );
    }

    form.addEventListener('submit', (evento) => {
      evento.preventDefault();
      if (!form.reportValidity()) return;

      const dados = new FormData(form);
      const tipo = dados.get('tipo');
      if (typeof tipo !== 'string' || !tiposPedido.includes(tipo)) {
        mostrarFeedback('Selecione um tipo de pedido válido.', true);
        return;
      }

      const pedido: PedidoNovo = {
        protocolo: `2026-${String(1200 + pedidosSalvos.length + 1).padStart(5, '0')}`,
        tipo,
        data: new Date().toLocaleDateString('pt-BR'),
      };
      pedidosSalvos = [pedido, ...pedidosSalvos];
      adicionarNaLista(pedido);
      form.reset();

      try {
        localStorage.setItem(chaveArmazenamento, JSON.stringify(pedidosSalvos));
        mostrarFeedback(`Pedido enviado! Protocolo ${pedido.protocolo}.`);
      } catch (erro) {
        console.error('Não foi possível salvar o pedido da secretaria.', erro);
        mostrarFeedback(
          `Pedido incluído nesta sessão, mas não foi possível salvá-lo. Protocolo ${pedido.protocolo}.`,
          true,
        );
      }
    });
  });
</script>

<style>
  .pagina {
    display: grid;
    gap: 1.5rem;
    max-width: 1280px;
    margin-inline: auto;
  }

  .introducao {
    display: grid;
    gap: 0.5rem;
  }

  .introducao p,
  .suave {
    color: var(--fg--40);
  }

  .grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .card {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--fg--80);
    border-radius: 12px;
    background: var(--bg);
    box-shadow: 0 4px 12px rgb(18 12 7 / 8%);
  }

  .card h2 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    font-size: 1.35rem;
  }

  .card h2 :global(svg) {
    color: var(--primary-darker);
  }

  .tipos {
    display: grid;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    padding: 0;
    border: 0;
  }

  .tipos legend {
    margin-bottom: 0.55rem;
    font-weight: 700;
  }

  .opcao {
    display: flex;
    min-height: 48px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--fg--80);
    border-radius: 8px;
    cursor: pointer;
  }

  .opcao:hover,
  .opcao:has(input:checked) {
    border-color: var(--primary-darker);
    background: color-mix(in srgb, var(--primary) 10%, var(--bg));
  }

  .opcao input {
    width: 20px;
    height: 20px;
    accent-color: var(--primary-darker);
  }

  .campo {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .campo label {
    font-weight: 700;
  }

  .campo textarea {
    width: 100%;
    min-height: 110px;
    padding: 0.75rem;
    border: 1px solid var(--fg--70);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    resize: vertical;
  }

  .campo textarea:focus-visible {
    outline: 3px solid var(--primary-darker);
    outline-offset: 2px;
  }

  .botao-primario {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--primary-darker);
    border-radius: 8px;
    background: var(--primary-darker);
    color: var(--bg);
    font-weight: 700;
    cursor: pointer;
  }

  .botao-primario:hover {
    background: var(--primary);
  }

  .botao-primario:focus-visible {
    outline: 3px solid var(--primary-darker);
    outline-offset: 3px;
  }

  .feedback {
    min-height: 1.5rem;
    margin-top: 0.75rem;
    font-weight: 700;
  }

  .feedback-sucesso {
    color: var(--success--fg);
  }

  .feedback-erro {
    color: var(--error--fg);
  }

  .lista-pedidos {
    display: grid;
    gap: 0.85rem;
    padding: 0;
    list-style: none;
  }

  .lista-pedidos li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--fg--80);
  }

  .icone-pedido {
    display: grid;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 10px;
    background: color-mix(in srgb, var(--primary) 14%, var(--bg));
    color: var(--primary-darker);
  }

  .pedido-corpo {
    min-width: 0;
    flex: 1;
  }

  .pedido-tipo {
    margin-bottom: 0.15rem;
    font-weight: 700;
  }

  .pedido-info {
    color: var(--fg--40);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  .status-pedido {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .status-concluido {
    color: var(--fg);
    background: var(--success--bg);
  }

  .status-analise {
    color: var(--fg);
    background: var(--warning--bg);
  }

  @media (max-width: 900px) {
    .grade {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .card {
      padding: 0.8rem;
    }

    .lista-pedidos li {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .status-pedido {
      margin-left: 3.25rem;
    }
  }
</style>
