---
import BaseHead from '../components/BaseHead.astro';
import { FormCadastroAluno } from '../components/FormCadastroAluno/FormCadastroAluno.tsx';
---

<!doctype html>
<html lang="pt-br">
  <head>
    <BaseHead title="Cadastrar | EducaHub" description="Faça agora seu cadastro na EducaHub" />
  </head>
  <body>
    <main>
      <div class="container">
        <FormCadastroAluno client:load />
      </div>
    </main>
    <footer>
      <a href="/entrar">Já possui conta? Faça o login aqui</a>
    </footer>
  </body>
</html>

<style>
  main {
    position: relative;
    height: 100vh;
    padding: 0 var(--side-padding);

    .container {
      --width: 70vw;
      @media (max-width: 480px) {
        --width: 80vw;
      }

      @media (max-width: 420px) {
        --width: 85vw;
      }

      @media (max-width: 380px) {
        --width: 90vw;
      }

      @media (max-width: 360px) {
        --width: 95vw;
      }

      @media (max-width: 340px) {
        --width: 98vw;
      }

      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: var(--width);
      max-width: 686px;
      padding: 32px var(--side-padding);

      background: var(--bg);
      border: 2px dashed var(--fg--60);
      border-top: 6px solid var(--primary);
      border-radius: 24px;

      z-index: 20;
    }
  }

  footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: fit-content;

    padding: 8px var(--side-padding);
    display: flex;
    flex-direction: row;
    justify-content: center;

    background-color: var(--fg--80);
    border-radius: 12px 12px 0 0;

    z-index: 10;
  }

  /* Efeito Background */
  @media (prefers-reduced-motion: no-preference) {
    @property --c-0 {
      syntax: '<color>';
      inherits: false;
      initial-value: hsla(20, 80%, 58%, 1);
    }

    @property --x-0 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 15%;
    }

    @property --y-0 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 40%;
    }

    @property --s-start-0 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 5%;
    }

    @property --s-end-0 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 70%;
    }

    @property --c-1 {
      syntax: '<color>';
      inherits: false;
      initial-value: hsla(213, 100%, 59%, 1);
    }

    @property --x-1 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 85%;
    }

    @property --y-1 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 100%;
    }

    @property --s-start-1 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 10%;
    }

    @property --s-end-1 {
      syntax: '<percentage>';
      inherits: false;
      initial-value: 70%;
    }

    @keyframes ani-bg-mesh {
      0% {
        --c-0: hsla(20, 80%, 58%, 1);
        --x-0: 15%;
        --y-0: 40%;
        --s-start-0: 5%;
        --s-end-0: 70%;
        --c-1: hsla(213, 100%, 59%, 1);
        --x-1: 85%;
        --y-1: 100%;
        --s-start-1: 10%;
        --s-end-1: 70%;
      }

      25% {
        --c-0: hsla(20, 80%, 58%, 1);
        --x-0: 85%;
        --y-0: 40%;
        --s-start-0: 5%;
        --s-end-0: 70%;
        --c-1: hsla(213, 100%, 59%, 1);
        --x-1: 15%;
        --y-1: 100%;
        --s-start-1: 10%;
        --s-end-1: 70%;
      }

      50% {
        --c-0: hsla(20, 80%, 58%, 1);
        --x-0: 85%;
        --y-0: 100%;
        --s-start-0: 10%;
        --s-end-0: 70%;
        --c-1: hsla(213, 100%, 59%, 1);
        --x-1: 15%;
        --y-1: 40%;
        --s-start-1: 5%;
        --s-end-1: 70%;
      }

      75% {
        --c-0: hsla(20, 80%, 58%, 1);
        --x-0: 15%;
        --y-0: 100%;
        --s-start-0: 10%;
        --s-end-0: 70%;
        --c-1: hsla(213, 100%, 59%, 1);
        --x-1: 85%;
        --y-1: 40%;
        --s-start-1: 5%;
        --s-end-1: 70%;
      }

      100% {
        --c-0: hsla(20, 80%, 58%, 1);
        --x-0: 15%;
        --y-0: 40%;
        --s-start-0: 5%;
        --s-end-0: 70%;
        --c-1: hsla(213, 100%, 59%, 1);
        --x-1: 85%;
        --y-1: 100%;
        --s-start-1: 10%;
        --s-end-1: 70%;
      }
    }

    main::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 25%;

      --c-0: hsla(20, 80%, 58%, 1);
      --x-0: 15%;
      --y-0: 40%;
      --c-1: hsla(213, 100%, 59%, 1);
      --x-1: 85%;
      --y-1: 100%;

      background-color: rgba(from var(--bg) r g b / 0);
      background-image:
        radial-gradient(
          circle at var(--x-0) var(--y-0),
          var(--c-0) var(--s-start-0),
          transparent var(--s-end-0)
        ),
        radial-gradient(
          circle at var(--x-1) var(--y-1),
          var(--c-1) var(--s-start-1),
          transparent var(--s-end-1)
        );

      animation: ani-bg-mesh 15s linear infinite normal;
      background-blend-mode: overlay, overlay;
      mask-image:
        repeating-linear-gradient(45deg, #fff, #fff 1px, transparent 1px, transparent 8px),
        repeating-linear-gradient(135deg, #fff, #fff 1px, transparent 1px, transparent 8px);

      will-change: transform, opacity;
      contain: paint;
      pointer-events: none;
    }
  }
</style>
