          fill="url(#underline-gradient)"
          stroke="url(#underline-gradient)"
        />
      </svg>
    </div>

    <div class="container" id="missao">
      <div class="wrapper">
        <Image src={missao} alt="" />
        <h3 class="marker-text">Missão</h3>
      </div>
      <p>
        A nossa missão é aproximar alunos, famílias, professores e gestores por meio de uma
        plataforma simples, acolhedora e eficiente.
        <br />
        Trabalhamos para que o acompanhamento do dia a dia escolar esteja ao alcance de qualquer
        cidadão sergipano, garantindo que o acesso à educação pública seja um direito sem barreiras
        — da matrícula online à celebração da formatura.
      </p>
    </div>
    <div class="container" id="valores">
      <div class="wrapper">
        <h3 class="marker-text">Valores</h3>
        <Image src={valores} alt="" />
      </div>
      <ul>
        <li>
          <strong>Design Universal e Inclusão:</strong> Projetamos para todos, unindo
          acessibilidade, recursos intuitivos e paletas semânticas. Uma plataforma pública deve ser
          compreendida e utilizada por todos, independentemente de suas necessidades.
        </li>
        <li>
          <strong>Respeito às Diversidades:</strong> Desenhamos nossa plataforma com recursos
          intuitivos, garantindo que a informação seja compreendida por todos.
        </li>
        <li>
          <strong>Tecnologia Leve:</strong> Desenvolvemos um portal que funciona em qualquer
          aparelho e consome o mínimo de dados, respeitando a realidade de cada estudante.
        </li>
        <li>
          <strong>Transparência:</strong> Conectamos a sala de aula, à gestão da SEDUC e à rotina da
          família em um canal único direto, seguro e honesto.
        </li>
      </ul>
    </div>
    <div class="container" id="visao">
      <div class="wrapper">
        <h3 class="marker-text">Visão</h3>
        <Image src={visao} alt="" />
      </div>
      <p>
        Uma rede de ensino onde todos possam participar igualmente. Queremos ser o portal
        educacional de referência em acessibilidade e inclusão no Brasil.
        <br />
        Nosso horizonte é garantir que todo sergipano — independentemente de limitações visuais,
        motoras, do nível de letramento ou do celular que possui — navegue com total autonomia,
        acompanhe o aprendizado e se sinta pertencente à nossa rede de ensino.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger, ScrollSmoother } from 'gsap/all';

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const initGSAPanimations = () => {
    // Scroll Suave
    const smoothScroll = () => {
      ScrollSmoother.create({
        wrapper: '#smooth-wrapper',
        content: '#smooth-content',
        smooth: 1.5,
        smoothTouch: 0.2,
        effects: true,
      });
    };

    // Animação do Traço sobre o Titulo "Nosso Propósito"
    const underlineSectionTitle = () => {
      const stop1 = '#title-underline #stop1';
      const stop2 = '#title-underline #stop2';

      gsap.fromTo(
        [stop1, stop2],
        {
          attr: { offset: '0%' },
        },
        {
          attr: { offset: '100%' },
          ease: 'slow(0.3,0.4,false)',
          scrollTrigger: {
            trigger: '.title-wrapper',
            start: 'top 70%',
            end: 'bottom 30%',
            scrub: true,
            toggleActions: 'play none none none',
            //markers: true,
          },
        },
      );
    };

    // Revelar Footer
    const footerReveal = () => {
      gsap.fromTo(
        'footer',
        {
          y: -100,
        },
        {
          y: 0,
          ease: 'circ.out',
          scrollTrigger: {
            trigger: 'body',
            start: 'center top',
            end: 'bottom bottom',
            scrub: 1,
            toggleActions: 'play none none reverse',
            //markers: true,
          },
        },
      );
    };

    smoothScroll();
    underlineSectionTitle();
    footerReveal();
  };

  if (!prefersReducedMotion) {
    initGSAPanimations();
  }
</script>

<style
  is:global
  define:vars={{
    heroLight: `url("${heroLight.src}")`,
    heroDark: `url("${heroDark.src}")`,
    cta: `url("${cta.src}")`,
  }}
>
  #hero {
    height: 100vh;

    background-image: var(--heroLight);
    background-size: cover;
    background-position: center;

    @media (prefers-color-scheme: dark) {
      background-image: var(--heroDark);
    }

    .container {
      position: relative;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);

      width: 600px;
      max-width: 100%;

      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    #hero-title {
      color: var(--dark);
      width: 100%;
    }

    #cta {
      width: fit-content;
      align-self: flex-end;

      background-image: var(--cta);
      background-size: cover;
      background-position: center;

      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 8px;

      color: var(--light);

      h3 {
        position: relative;
      }

      h3::after {
        content: '';
        position: absolute;
        width: 98%;
        height: 2px;
        bottom: 4px;
        left: 4px;
        background-color: var(--light);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
      }

      img {
        transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
      }
    }

    #cta:hover {
      h3::after {
        transform: scaleX(1);
        transform-origin: left;
      }

      img {
        transform: rotate(45deg); /* Turns the arrow into a crisp diagonal pointing gesture */
      }
    }
  }

  .paintDivider {
    position: relative;
    transform: translateY(-40%);
    z-index: 2;

    margin-bottom: -200px;
  }

  #Sobre {
    --offset: round(nearest, 45vw, 2px);
    @media (max-width: 1278px) {
      --offset: round(nearest, 25vw, 2px);
    }

    @media (max-width: 626px) {
      --offset: round(nearest, 5vw, 2px);
    }

    min-height: 100vh;
    width: 100vw;

    padding: 20px var(--side-padding) 80px var(--side-padding);

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;

    .title-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      width: 100%;

      h2 {
        text-align: center;
      }
    }

    .container {
      width: 100%;

      .wrapper {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
      }
    }

    #missao,
    #visao {
      padding-right: var(--offset);
    }
    #valores {
      padding-left: var(--offset);
    }
  }
</style>
