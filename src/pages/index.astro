---
import { Image } from 'astro:assets';

import Layout from '../layouts/Landing.astro';

//Assets Hero
import heroLight from '../assets/landing/hero-light.jpg';
import heroDark from '../assets/landing/hero-Dark.jpg';
import cta from '../assets/landing/cta.svg';
import arrowUpRight from '../assets/icons/arrow-up-right.svg';

//Assets Sobre
import missao from '../assets/landing/missao.svg';
import valores from '../assets/landing/valores.svg';
import visao from '../assets/landing/visao.svg';

import PaintDivider from '../components/PaintDivider.astro';
---

<Layout>
  <section id="hero">
    <div class="container">
      <h2 id="hero-title" class="marker-text">
        Conectando a rede de ensino de Sergipe.
      </h2>
      <a href="" id="cta" aria-label="Matricula Online">
        <h3>Matricula Online</h3>
        <Image src={arrowUpRight} alt="Faça agora a matrícula online" priority />
      </a>
    </div>
  </section>

  <PaintDivider class="paintDivider" />

  <section id="Sobre">
    <div class="title-wrapper">
      <h2 class="marker-text">Nosso Propósito</h2>
      <svg
        id="title-underline"
        width="458"
        height="10"
        viewBox="0 0 458 10"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <linearGradient id="underline-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <!-- Colored stop (fills from left to right) -->
            <stop id="stop1" offset="0%" stop-color="var(--fg)" stop-opacity="0.9" />
            <!-- Transparent stop -->
            <stop id="stop2" offset="0%" stop-color="var(--fg)" stop-opacity="0" />
          </linearGradient>
        </defs>

        <path
